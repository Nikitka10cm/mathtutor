{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathtutor",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-10",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
